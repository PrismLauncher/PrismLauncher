{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    {
      "name": "ecm",
      "host": true
    },
    {
      "name": "libqrencode",
      "default-features": false
    },
    {
      "name": "pkgconf",
      "host": true
    },

    "cmark",
    {
      "name": "libarchive",
      "default-features": false,
      "features": [
        "bzip2",
        "lz4",
        "lzma",
        "lzo",
        "zstd"
      ]
    },
    "tomlplusplus",
    "zlib"
  ]
}
